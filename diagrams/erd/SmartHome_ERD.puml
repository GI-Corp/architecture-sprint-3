@startuml

!define primary_key(x) <b>x</b>
!define foreign_key(x) <i>x</i>

skinparam linetype ortho

title ER-диаграмма "Тёплый Дом"

entity User {
    primary_key(id) UUID
    name String
    email String UNIQUE
    password_hash String
}

entity UserSession {
    primary_key(id) UUID
    user_id UUID
    token String UNIQUE
    created_at DateTime
    expires_at DateTime
}

entity House {
    primary_key(id) UUID
    address String UNIQUE
}

entity UserHouse {
    primary_key(id) UUID
    user_id UUID
    house_id UUID
}

entity Device {
    primary_key(id) UUID
    serial_number String UNIQUE
    status String
    house_id UUID
    device_type_id UUID
}

entity DeviceType {
    primary_key(id) UUID
    name String UNIQUE
}

entity Module {
    primary_key(id) UUID
    name String
    device_id UUID
}

entity TelemetryData {
    primary_key(id) UUID
    device_id UUID
    timestamp DateTime
    temperature Float
    humidity Float
}

entity DeviceLog {
    primary_key(id) UUID
    device_id UUID
    timestamp DateTime
    event_type String
    details String
}

entity HeatingControl {
    primary_key(id) UUID
    house_id UUID
    target_temperature Float
    status String
}

entity Sensor {
    primary_key(id) UUID
    module_id UUID
    sensor_type String
    last_value Float
}

entity SensorData {
    primary_key(id) UUID
    sensor_id UUID
    timestamp DateTime
    value Float
}

entity EventLog {
    primary_key(id) UUID
    source String
    event_type String
    timestamp DateTime
    message String
}

User ||--o{ UserSession : "has"
User ||--o{ UserHouse : "links"
UserHouse ||--|| House : "associates"
House ||--o{ Device : "has"
Device ||--|| DeviceType : "belongs to"
Device ||--o{ Module : "contains"
Module ||--o{ Sensor : "has"
Sensor ||--o{ SensorData : "generates"
Device ||--o{ TelemetryData : "sends"
Device ||--o{ DeviceLog : "logs"
House ||--|| HeatingControl : "controls"
Device -- EventLog : "triggers"

@enduml